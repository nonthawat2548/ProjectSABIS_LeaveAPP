{
  "name": "leave-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:cloud": "node scripts/dev-api.mjs --cloud",
    "cloud:server": "node --env-file-if-exists=.env --import tsx server/cloud-dev.ts",
    "mock:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "seed": "node --env-file-if-exists=.env --import tsx server/seed.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  }
}
