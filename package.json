{
  "name": "leave-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:cloud": "node scripts/dev-api.mjs --cloud",
    "dev:legacy": "node scripts/dev-api.mjs --legacy",
    "go:server": "node scripts/go.mjs run ./cmd/server",
    "test:go": "node scripts/go.mjs test ./api/... ./serverless/... ./cmd/... ./internal/... ./src/data/... ./scripts/go-contract/...",
    "test:go:vercel": "node scripts/test-go-vercel.mjs",
    "test:parity": "node scripts/test-go-parity.js",
    "test:go:postgres": "node scripts/test-go-postgres.js",
    "build:go": "node scripts/go.mjs build ./api/... ./serverless/... ./cmd/... ./internal/... ./src/data/... ./scripts/go-contract/...",
    "vet:go": "node scripts/go.mjs vet ./api/... ./serverless/... ./cmd/... ./internal/... ./src/data/... ./scripts/go-contract/...",
    "cloud:server": "node --env-file-if-exists=.env server/cloud-dev.js",
    "mock:server": "node --env-file-if-exists=.env server/index.js",
    "test": "npm run test:unit && npm run test:ui",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "format": "prettier --write \"{src,server,api,tests,scripts}/**/*.{js,jsx,mjs,cjs,css}\" \"*.{json,js,cjs}\"",
    "format:check": "prettier --check \"{src,server,api,tests,scripts}/**/*.{js,jsx,mjs,cjs,css}\" \"*.{json,js,cjs}\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "data:generate": "node scripts/generate-demo.js && python scripts/build-sqlite.py && node scripts/generate-supabase.mjs",
    "data:check": "node scripts/generate-demo.js --check && python scripts/build-sqlite.py --check && node scripts/generate-supabase.mjs --check",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "history:clear": "node scripts/clear-local-history.js",
    "test:unit": "node --import ./scripts/register-jsx.mjs --test tests/*.test.js",
    "test:ui": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint src"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@babel/preset-react": "7.29.7",
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-socket": "0.0.19",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "@babel/core": "7.29.7"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
