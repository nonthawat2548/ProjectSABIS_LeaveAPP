# mock = persistent browser demo (IndexedDB); api = mock REST server / your own server
VITE_DATA_MODE=mock
# Use same-origin /api via Vite proxy. For your own backend, set its URL.
VITE_API_BASE_URL=/api
# Optional for local Node mock server. Keep on localhost for demonstration.
MOCK_HOST=127.0.0.1
MOCK_PORT=3001
