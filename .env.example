# mock = browser demo (IndexedDB); api = Go + Gin REST API
VITE_DATA_MODE=mock
# Use same-origin /api via Vite proxy. For your own backend, set its URL.
VITE_API_BASE_URL=/api

# Shared Vercel API: Vercel integration supplies POSTGRES_URL server-side.
# Never prefix POSTGRES_URL or passwords with VITE_.
# ENABLE_DEMO_LOGIN=true enables the existing fictional ten-account demo only.
# For local cloud development, set POSTGRES_URL in .env (ignored by git), then use dev:cloud.
# POSTGRES_URL=
# ENABLE_DEMO_LOGIN=true
# Go local demo uses its own JSON runtime; cloud uses the existing PostgreSQL schema.
# GO_DATA_MODE=json
# GO_DATA_FILE=server/data/leave-management-go.json
# Set GO_DATA_MODE=postgres for `go run ./cmd/server` with the shared database.
# POSTGRES_LOCAL=true is only for an explicitly configured loopback test database.
# Optional CORS allowlist for a separate frontend origin (comma separated).
# GO_ALLOWED_ORIGINS=http://localhost:5173
# Local development server. Vite proxies /api to this address.
MOCK_HOST=127.0.0.1
MOCK_PORT=3001
